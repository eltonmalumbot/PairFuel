{
  "name": "pairfuel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:regression && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:regression": "node scripts/regression-check.mjs",
    "qa": "npm run test:regression && npm run typecheck && next build",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.0.0",
    "next": "16.3.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "typescript": "5.8.3"
  }
}
